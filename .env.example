# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só no servidor (Vercel > Environment Variables). Nunca expor no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Endereço público do app (usado nos links de e-mail)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Botões de login social exibidos (ative cada um no Supabase > Authentication > Providers)
NEXT_PUBLIC_AUTH_PROVIDERS=google
# E-mails com acesso ao painel do dono do SaaS (/admin), separados por vírgula
ADMIN_EMAILS=

# E-mails (Resend). EMAIL_FROM precisa usar um domínio verificado no Resend, ex.: Só Marcar <agenda@somarcar.com.br>
RESEND_API_KEY=
EMAIL_FROM=
# Senha que o Vercel Cron usa para chamar /api/cron/notifications (qualquer texto longo e aleatório)
CRON_SECRET=

# Assinatura do SaaS (Stripe Billing). Comece SEMPRE com chaves de teste (sk_test_...).
STRIPE_SECRET_KEY=
# Segredo do endpoint https://SEU-SITE/api/webhooks/stripe (Stripe > Developers > Webhooks)
STRIPE_WEBHOOK_SECRET=
# Só "true" depois de testar tudo: libera chaves sk_live_ (cobrança real)
BILLING_LIVE_ENABLED=

# Pagamentos dos serviços (cliente -> estabelecimento). Nenhum provedor ativo por padrão.
# Ex.: PAYMENT_PROVIDERS_ENABLED=asaas  (só depois de testes e validação comercial)
PAYMENT_PROVIDERS_ENABLED=
# 32 bytes em base64 para criptografar as credenciais dos estabelecimentos: openssl rand -base64 32
PAYMENT_CREDENTIALS_KEY=
